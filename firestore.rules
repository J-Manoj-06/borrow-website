rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'Super Admin' ||
        request.auth.token.role == 'Library Administrator' ||
        request.auth.token.role == 'Librarian' ||
        getUserData().role != null
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'Super Admin' ||
        getUserData().role == 'Super Admin'
      );
    }

    // Books Collection
    match /books/{bookId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Book Copies Collection
    match /bookCopies/{copyId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid == studentId);
      allow delete: if isSuperAdmin();
    }

    // Borrow Requests Collection
    match /borrowRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Notifications & Announcements Collections
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Activity Logs Collection (Read-only for Admins, Write by System/Admin)
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable Audit Logs
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }
  }
}
